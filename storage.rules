rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null
        && (request.auth.token.email.toLowerCase() == 'exinia@fraustrohbach.de'
             || request.auth.token.email.toLowerCase() == 'katadvaya@fraustrohbach.de'
             || request.auth.token.admin == true);
    }
  }
}
