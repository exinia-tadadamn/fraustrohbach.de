rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Email-Check OHNE toLowerCase() (Firestore Rules unterstützt das nicht).
    // Wir vergleichen gegen alle plausiblen Case-Varianten.
    // Da das Projekt nur 2 Admin-Emails hat, ist der Aufwand vertretbar.
    function isAdminEmail(email) {
      return email == 'exinia@fraustrohbach.de'
          || email == 'Exinia@fraustrohbach.de'
          || email == 'EXINIA@fraustrohbach.de'
          || email == 'eXiNiA@fRaUsTrOhBaCh.de'
          || email == 'katadvaya@fraustrohbach.de'
          || email == 'Katadvaya@fraustrohbach.de'
          || email == 'KATADVAYA@fraustrohbach.de'
          || email == 'kAtAdVaYa@FrAuStRoHbAcH.de';
    }

    function isAdmin() {
      return request.auth != null
        && (
          (request.auth.token.email != null
            && isAdminEmail(request.auth.token.email))
          || request.auth.token.admin == true
        );
    }

    match /blogPosts/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
            && request.resource.data.viewCount > resource.data.viewCount);
    }

    match /galleryAlbums/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Galerie-Alben der "About the Artist"-Sektion.
    // Hinweis: Frontend schreibt in 'artistGalleryAlbums' (nicht 'galleryAlbums').
    match /artistGalleryAlbums/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Galerie-Bilder
    match /artistGalleryImages/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /userProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /nicknames/{nick} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
  }
}
